{
  "name": "tree-lens",
  "version": "0.1.5",
  "description": "Tree Lens",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.trickortree.treelens",
    "productName": "Tree Lens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "ai.js",
      "preload.js",
      "bar.html",
      "bar.js",
      "overlay.html",
      "overlay-preload.js",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Tree-Lens-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "trickortree",
      "repo": "tree-lens",
      "releaseType": "release"
    }
  }
}
